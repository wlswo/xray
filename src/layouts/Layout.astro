---
interface Props {
  title: string;
}
const { title } = Astro.props;
const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Xray - Universal UI capture and inspection tool for macOS. Like Chrome DevTools inspector, but for your entire screen." />
    <meta name="theme-color" content="#0a0a0a" />
    <meta property="og:title" content="Xray — See through your screen" />
    <meta property="og:description" content="Universal UI capture and inspection tool for macOS. Like Chrome DevTools inspector, but for your entire screen." />
    <meta property="og:image" content="https://raw.githubusercontent.com/wlswo/xray/main/assets/xray-logo.png" />
    <meta property="og:url" content="https://wlswo.me/xray/" />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://raw.githubusercontent.com/wlswo/xray/main/assets/xray-logo.png" />
    <link rel="icon" type="image/png" href={`${base}icon.png`} />
    <title>{title}</title>
  </head>
  <body class="bg-[#0a0a0a] text-gray-200 antialiased overflow-x-hidden">
    <slot />
  </body>
</html>

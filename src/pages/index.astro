---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;

// Last known star count — used when the API is unreachable or rate limited at build time.
// Updated: 2026-08-23
const FALLBACK_STARS = 286;

// Fetch GitHub star count at build time (with timeout + graceful fallback)
let stars: number | null = FALLBACK_STARS;
try {
  const controller = new AbortController();
  const timeoutId = setTimeout(() => controller.abort(), 3000);
  const res = await fetch('https://api.github.com/repos/wlswo/xray', {
    signal: controller.signal,
    headers: { Accept: 'application/vnd.github+json' },
  });
  clearTimeout(timeoutId);
  if (res.ok) {
    const data = await res.json();
    stars = typeof data.stargazers_count === 'number' ? data.stargazers_count : FALLBACK_STARS;
  }
} catch {
  // Network error or rate limit — fall back to the last known count
}

function formatStars(n: number): string {
  if (n < 1000) return String(n);
  if (n < 10000) return (n / 1000).toFixed(1).replace(/\.0$/, '') + 'k';
  return Math.floor(n / 1000) + 'k';
}

type Testimonial = {
  quote: string;
  name: string;
  role: string;
  initials: string;
  avatar?: string;
  avatarBg: string;
  avatarText: string;
};
const testimonials: Testimonial[] = [
  {
    quote: "it is awesome!",
    name: "mr.hukihwang",
    role: "Diver",
    initials: "MH",
    avatar: `${base}avatars/hukihwang.png`,
    avatarBg: "bg-cyan-500/20",
    avatarText: "text-cyan-300",
  },
  {
    quote: "Well-written. It's good.",
    name: "Jay Choi",
    role: "Plumber · Cursed by knowledge",
    initials: "JC",
    avatar: `${base}avatars/choi_jay.png`,
    avatarBg: "bg-teal-500/20",
    avatarText: "text-teal-300",
  },
  {
    quote: "Hallelujah. No more screenshot purgatory.",
    name: "San Ahn",
    role: "Priest · Heaven's guide",
    initials: "SA",
    avatar: `${base}avatars/sanahn.png`,
    avatarBg: "bg-indigo-500/20",
    avatarText: "text-indigo-300",
  },
  {
    quote: "Wanna try it. Helldivers, go.",
    name: "Soong Sin",
    role: "Engineer · $100K+ salary",
    initials: "SS",
    avatar: `${base}avatars/SungiShin.png`,
    avatarBg: "bg-orange-500/20",
    avatarText: "text-orange-300",
  },
  {
    quote: "I trust two things: my Geiger counter and Xray.",
    name: "Jordan Beck",
    role: "Radiation Tech · One Hundred Eyes",
    initials: "JB",
    avatar: `${base}avatars/JordanBeck.png`,
    avatarBg: "bg-lime-500/20",
    avatarText: "text-lime-300",
  },
];
---

<Layout title="Xray — See through your screen">
  <!-- Nav -->
  <nav class="fixed top-0 w-full z-50 backdrop-blur-md bg-white/80 dark:bg-[#0a0a0a]/80 border-b border-black/[0.06] dark:border-white/5">
    <div class="max-w-6xl mx-auto px-6 h-20 flex items-center justify-between">
      <a href="#" onclick="window.scrollTo({top:0,behavior:'smooth'});return false;" class="flex items-center gap-3">
        <img src={`${base}icon.png`} alt="Xray" class="h-10 rounded-lg" />
        <span class="font-semibold text-gray-900 dark:text-white text-2xl">Xray</span>
      </a>
      <div class="flex items-center gap-2 sm:gap-8">
        <a href="#built-for" class="hidden sm:inline text-lg text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white transition-colors">Use cases</a>
        <a href="#demo" class="hidden sm:inline text-lg text-gray-600 hover:text-gray-900 dark:text-gray-400 dark:hover:text-white transition-colors">Demo</a>
        <button id="theme-toggle" type="button" aria-label="Toggle theme" class="inline-flex items-center justify-center w-11 h-11 rounded-lg bg-black/[0.04] hover:bg-black/[0.06] dark:bg-white/5 dark:hover:bg-white/10 border border-black/[0.06] dark:border-white/10 text-gray-700 dark:text-gray-300 transition-colors">
          {/* Sun (visible in dark mode → click goes to light) */}
          <svg class="w-5 h-5 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"/></svg>
          {/* Moon (visible in light mode → click goes to dark) */}
          <svg class="w-5 h-5 block dark:hidden" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21.752 15.002A9.72 9.72 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"/></svg>
        </button>
        <a href="https://github.com/wlswo/xray" target="_blank" rel="noopener" class="inline-flex rounded-lg bg-black/[0.04] hover:bg-black/[0.06] dark:bg-white/5 dark:hover:bg-white/10 border border-black/[0.08] dark:border-white/10 text-lg text-gray-700 hover:text-gray-900 dark:text-gray-200 dark:hover:text-white transition-all">
          {stars !== null && (
            <Fragment>
              <span class="flex items-center gap-2 pl-4 pr-4 sm:pl-5 py-3 font-semibold">
                <svg class="w-5 h-5 text-amber-300" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.286 3.957a1 1 0 00.95.69h4.16c.969 0 1.371 1.24.588 1.81l-3.366 2.446a1 1 0 00-.364 1.118l1.286 3.957c.3.921-.755 1.688-1.539 1.118l-3.366-2.446a1 1 0 00-1.176 0l-3.366 2.446c-.784.57-1.838-.197-1.539-1.118l1.286-3.957a1 1 0 00-.364-1.118L2.05 9.384c-.783-.57-.38-1.81.588-1.81h4.16a1 1 0 00.95-.69l1.286-3.957z"/></svg>
                {formatStars(stars)}
              </span>
              <span aria-hidden="true" class="hidden sm:block w-px bg-black/[0.1] dark:bg-white/15 my-2"></span>
            </Fragment>
          )}
          <span class={`hidden sm:flex items-center gap-2 py-3 ${stars !== null ? 'pl-4 pr-5' : 'px-5'}`}>
            <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/></svg>
            Star on GitHub
          </span>
        </a>
      </div>
    </div>
  </nav>

  <!-- Hero -->
  <section class="relative pt-24 sm:pt-28 pb-12 sm:pb-20">
    <!-- Background glow -->
    <div class="absolute inset-0 overflow-hidden">
      <div class="absolute top-1/3 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[600px] bg-xray-green/10 rounded-full blur-[120px]"></div>
    </div>

    <div class="relative max-w-[1200px] mx-auto px-6 text-center">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-xray-green/30 bg-xray-green/10 mb-6">
        <span class="w-2 h-2 rounded-full bg-xray-green animate-pulse"></span>
        <span class="text-xray-green-light text-sm font-medium">macOS Native App</span>
      </div>

      <h1 class="text-5xl sm:text-7xl font-bold tracking-tight text-gray-900 dark:text-white mb-4 hero-headline">
        <span class="hero-word" style="--i: 0">See</span>
        <span class="hero-word" style="--i: 1">through</span><br/>
        <span class="hero-word hero-word-gradient text-transparent bg-clip-text bg-gradient-to-r from-xray-green via-emerald-400 to-xray-green" style="--i: 2">your screen</span>
      </h1>

      <p class="text-lg sm:text-xl text-gray-600 dark:text-gray-400 max-w-2xl mx-auto mb-3 leading-relaxed">
        Chrome DevTools Inspector — for your entire macOS.
      </p>
      <p class="text-base text-gray-500 dark:text-gray-500 max-w-2xl mx-auto mb-8 leading-relaxed">
        Stop the screenshot &rarr; measure &rarr; annotate cycle.
      </p>

      <div class="flex flex-col items-center justify-center gap-3 mb-8">
        <a href="https://github.com/wlswo/xray/releases/download/v1.1.0/xray_1.1.0_aarch64.dmg"
          class="group inline-flex items-center gap-2 px-8 py-3 bg-xray-green hover:bg-xray-green-light text-white font-semibold rounded-xl transition-all hover:shadow-[0_0_30px_rgba(69,120,87,0.4)]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 16v2a2 2 0 002 2h12a2 2 0 002-2v-2M7 10l5 5 5-5M12 15V3"/></svg>
          Download for Mac
        </a>
        <p class="text-xs text-gray-500">Apple Silicon (M1/M2/M3/M4) &middot; Intel support coming soon</p>
      </div>

      <!-- Shortcut hint -->
      <div class="mb-12 inline-flex items-center gap-2 px-4 py-2 rounded-xl bg-black/[0.03] dark:bg-white/[0.03] border border-black/[0.06] dark:border-white/5">
        <span class="text-gray-600 dark:text-gray-500 text-sm mr-1 hidden sm:inline">Press</span>
        <kbd class="px-2.5 py-1 bg-black/[0.06] dark:bg-white/10 border border-black/[0.1] dark:border-white/15 rounded-md text-sm font-mono font-semibold text-gray-800 dark:text-gray-100">⌘ Cmd</kbd>
        <span class="text-gray-400 dark:text-gray-500">+</span>
        <kbd class="px-2.5 py-1 bg-black/[0.06] dark:bg-white/10 border border-black/[0.1] dark:border-white/15 rounded-md text-sm font-mono font-semibold text-gray-800 dark:text-gray-100">Shift</kbd>
        <span class="text-gray-400 dark:text-gray-500">+</span>
        <kbd class="px-2.5 py-1 bg-black/[0.06] dark:bg-white/10 border border-black/[0.1] dark:border-white/15 rounded-md text-sm font-mono font-semibold text-gray-800 dark:text-gray-100">X</kbd>
        <span class="text-gray-600 dark:text-gray-400 text-sm ml-1">to activate<span class="hidden sm:inline"> anywhere</span></span>
      </div>

      <!-- Video Showcase -->
      <div id="video-container" class="w-full max-w-[1200px] mx-auto">
        <!-- Stories-style progress bars -->
        <div class="flex gap-3 mb-4">
          <button type="button" data-video-idx="0" class="flex-1 text-left group cursor-pointer">
            <div data-progress-label class="text-base font-semibold text-xray-green-light mb-2 transition-colors group-hover:text-gray-900 dark:group-hover:text-white">Web Capture</div>
            <div class="h-1 bg-black/[0.1] dark:bg-white/10 rounded-full overflow-hidden">
              <div data-progress-fill class="h-full bg-xray-green" style="width: 0%;"></div>
            </div>
          </button>
          <button type="button" data-video-idx="1" class="flex-1 text-left group cursor-pointer">
            <div data-progress-label class="text-base font-semibold text-gray-400 dark:text-gray-500 mb-2 transition-colors group-hover:text-gray-900 dark:group-hover:text-white">App Capture</div>
            <div class="h-1 bg-black/[0.1] dark:bg-white/10 rounded-full overflow-hidden">
              <div data-progress-fill class="h-full bg-xray-green" style="width: 0%;"></div>
            </div>
          </button>
        </div>

        <!-- Video frame -->
        <div class="relative rounded-2xl border border-xray-green/20 bg-[#111] overflow-hidden shadow-[0_0_80px_rgba(69,120,87,0.25),0_0_160px_rgba(69,120,87,0.1)]">
          <video id="video-web" src={`${base}xray-web.mp4`} autoplay muted playsinline class="w-full block transition-opacity duration-500"></video>
          <video id="video-program" src={`${base}xray-program.mp4`} muted playsinline class="w-full absolute inset-0 opacity-0 transition-opacity duration-500"></video>
        </div>
      </div>
    </div>
  </section>

  <!-- Testimonials (auto-scrolling marquee) -->
  <section id="testimonials" class="reveal py-20 sm:py-32 overflow-hidden">
    <div class="max-w-6xl mx-auto px-6 mb-12 text-center">
      <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">Hear from our users</h2>
      <p class="text-xs text-gray-500 dark:text-gray-500">just my friends</p>
    </div>

    <div class="relative">
      <!-- Edge fade masks -->
      <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-12 sm:w-40 bg-gradient-to-r from-white dark:from-[#0a0a0a] to-transparent"></div>
      <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 sm:w-40 bg-gradient-to-l from-white dark:from-[#0a0a0a] to-transparent"></div>

      <!-- Marquee track (cards rendered twice for seamless loop) -->
      <div class="marquee-track flex gap-6 w-max">
        {[...testimonials, ...testimonials].map((t, i) => (
          <article aria-hidden={i >= testimonials.length ? 'true' : undefined} class="flex-shrink-0 w-[280px] sm:w-[408px] p-5 sm:p-6 rounded-2xl border border-black/[0.06] dark:border-white/5 bg-black/[0.02] dark:bg-white/[0.02] hover:border-black/[0.08] dark:hover:border-white/10 hover:bg-black/[0.03] dark:hover:bg-white/[0.03] transition-colors">
            <p class="text-gray-700 dark:text-gray-300 text-sm leading-relaxed mb-6">&ldquo;{t.quote}&rdquo;</p>
            <div class="flex items-center gap-3">
              {t.avatar ? (
                <img src={t.avatar} alt={t.name} class="w-10 h-10 rounded-full object-cover bg-black/[0.04] dark:bg-white/[0.05]" loading="lazy" />
              ) : (
                <div class={`w-10 h-10 rounded-full flex items-center justify-center font-semibold text-sm ${t.avatarBg} ${t.avatarText}`}>{t.initials}</div>
              )}
              <div>
                <div class="text-gray-900 dark:text-white text-sm font-medium">{t.name}</div>
                <div class="text-gray-600 dark:text-gray-500 text-xs">{t.role}</div>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Interactive Demo (hidden on mobile — hover-based interaction doesn't translate to touch) -->
  <section id="demo" class="reveal relative py-20 sm:py-32 hidden sm:block">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">Try it right here</h2>
        <p class="text-gray-600 dark:text-gray-400">Hover over the elements below. This is what Xray feels like.</p>
      </div>

      <!-- Mock UI -->
      <div id="xray-demo" class="relative mx-auto max-w-4xl rounded-2xl border border-white/10 bg-[#111] overflow-hidden select-none">
        <!-- Title bar -->
        <div class="flex items-center gap-2 px-4 py-3 bg-[#1a1a1a] border-b border-white/5" data-xray-role="Toolbar">
          <div class="flex gap-1.5">
            <div class="w-3 h-3 rounded-full bg-[#ff5f57]" data-xray-role="Button"></div>
            <div class="w-3 h-3 rounded-full bg-[#febc2e]" data-xray-role="Button"></div>
            <div class="w-3 h-3 rounded-full bg-[#28c840]" data-xray-role="Button"></div>
          </div>
          <div class="flex-1 text-center text-xs text-gray-500" data-xray-role="StaticText">My Application</div>
        </div>

        <!-- Mock content -->
        <div class="p-4 sm:p-8 grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6" data-xray-role="Group">
          <!-- Sidebar -->
          <div class="space-y-3" data-xray-role="List">
            <div class="px-4 py-2 rounded-lg bg-xray-green/20 text-xray-green-light text-sm font-medium" data-xray-role="MenuItem">Dashboard</div>
            <div class="px-4 py-2 rounded-lg text-gray-400 text-sm hover:bg-white/5" data-xray-role="MenuItem">Analytics</div>
            <div class="px-4 py-2 rounded-lg text-gray-400 text-sm hover:bg-white/5" data-xray-role="MenuItem">Settings</div>
            <div class="px-4 py-2 rounded-lg text-gray-400 text-sm hover:bg-white/5" data-xray-role="MenuItem">Users</div>
          </div>

          <!-- Main -->
          <div class="col-span-2 space-y-6">
            <!-- Stats row -->
            <div class="grid grid-cols-3 gap-4" data-xray-role="Group">
              <div class="p-4 rounded-xl bg-white/5 border border-white/5" data-xray-role="Group">
                <div class="text-xs text-gray-500 mb-1" data-xray-role="StaticText">Users</div>
                <div class="text-2xl font-bold text-white" data-xray-role="StaticText">12,847</div>
              </div>
              <div class="p-4 rounded-xl bg-white/5 border border-white/5" data-xray-role="Group">
                <div class="text-xs text-gray-500 mb-1" data-xray-role="StaticText">Revenue</div>
                <div class="text-2xl font-bold text-white" data-xray-role="StaticText">$48.2K</div>
              </div>
              <div class="p-4 rounded-xl bg-white/5 border border-white/5" data-xray-role="Group">
                <div class="text-xs text-gray-500 mb-1" data-xray-role="StaticText">Growth</div>
                <div class="text-2xl font-bold text-emerald-400" data-xray-role="StaticText">+23%</div>
              </div>
            </div>

            <!-- Chart placeholder -->
            <div class="h-40 rounded-xl bg-white/5 border border-white/5 flex items-end p-4 gap-2" data-xray-role="Image">
              <div class="flex-1 bg-xray-green/30 rounded-t" style="height:40%"></div>
              <div class="flex-1 bg-xray-green/40 rounded-t" style="height:65%"></div>
              <div class="flex-1 bg-xray-green/50 rounded-t" style="height:45%"></div>
              <div class="flex-1 bg-xray-green/60 rounded-t" style="height:80%"></div>
              <div class="flex-1 bg-xray-green/70 rounded-t" style="height:60%"></div>
              <div class="flex-1 bg-xray-green/80 rounded-t" style="height:90%"></div>
              <div class="flex-1 bg-xray-green rounded-t" style="height:75%"></div>
            </div>

            <!-- Button row -->
            <div class="flex gap-3" data-xray-role="Group">
              <div class="px-5 py-2 bg-xray-green rounded-lg text-sm font-medium text-white" data-xray-role="Button">Export Data</div>
              <div class="px-5 py-2 border border-white/10 rounded-lg text-sm text-gray-400" data-xray-role="Button">Share</div>
            </div>
          </div>
        </div>

        <!-- Xray overlay highlight -->
        <div id="xray-highlight" class="absolute pointer-events-none border-2 border-red-500 rounded-sm opacity-0 transition-all duration-150 ease-out"
          style="box-shadow: 0 0 0 4000px rgba(0,0,0,0.3), inset 0 0 20px rgba(239,68,68,0.15);"></div>

        <!-- Info HUD -->
        <div id="xray-hud" class="absolute pointer-events-none opacity-0 transition-opacity duration-150 z-10">
          <div class="bg-[#1a1a1a] border border-red-500/40 rounded-lg px-3 py-1.5 text-xs font-mono whitespace-nowrap shadow-lg">
            <span id="xray-hud-role" class="text-red-400"></span>
            <span class="text-gray-500 mx-1.5">|</span>
            <span id="xray-hud-size" class="text-gray-400"></span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Built for -->
  <section id="built-for" class="reveal py-20 sm:py-32">
    <div class="max-w-6xl mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="text-3xl sm:text-4xl font-bold text-gray-900 dark:text-white mb-4">Built for the way you actually work</h2>
        <p class="text-gray-600 dark:text-gray-400">Three workflows. One shortcut.</p>
      </div>

      <div class="grid sm:grid-cols-3 gap-8">
        <!-- Designers -->
        <div class="group p-8 rounded-2xl border border-black/[0.06] dark:border-white/5 bg-black/[0.02] dark:bg-white/[0.02] hover:border-xray-green/30 hover:bg-xray-green/[0.03] transition-all">
          <div class="w-12 h-12 rounded-xl bg-xray-green/10 flex items-center justify-center mb-6 group-hover:bg-xray-green/20 transition-colors">
            <svg class="w-6 h-6 text-xray-green" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.53 16.122a3 3 0 00-5.78 1.128 2.25 2.25 0 01-2.4 2.245 4.5 4.5 0 008.4-2.245c0-.399-.078-.78-.22-1.128zm0 0a15.998 15.998 0 003.388-1.62m-5.043-.025a15.994 15.994 0 011.622-3.395m3.42 3.42a15.995 15.995 0 004.764-4.648l3.876-5.814a1.151 1.151 0 00-1.597-1.597L14.146 6.32a15.996 15.996 0 00-4.649 4.763m3.42 3.42a6.776 6.776 0 00-3.42-3.42"/></svg>
          </div>
          <div class="text-sm text-xray-green-light font-medium mb-2">For designers</div>
          <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">Pixel-perfect audits</h3>
          <p class="text-gray-600 dark:text-gray-400 text-sm leading-relaxed">Measure spacing, sizing, and alignment across any macOS app. No more screenshot &rarr; Figma copy-paste loops.</p>
        </div>

        <!-- Developers -->
        <div class="group p-8 rounded-2xl border border-black/[0.06] dark:border-white/5 bg-black/[0.02] dark:bg-white/[0.02] hover:border-xray-green/30 hover:bg-xray-green/[0.03] transition-all">
          <div class="w-12 h-12 rounded-xl bg-xray-green/10 flex items-center justify-center mb-6 group-hover:bg-xray-green/20 transition-colors">

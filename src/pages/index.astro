  </style>

  <!-- Interactive Demo Script -->
  <script>
    const demo = document.getElementById('xray-demo')!;
    const highlight = document.getElementById('xray-highlight')!;
    const hud = document.getElementById('xray-hud')!;
    const hudRole = document.getElementById('xray-hud-role')!;
    const hudSize = document.getElementById('xray-hud-size')!;

    function findXrayTarget(el: Element | null): Element | null {
      while (el && el !== demo) {
        if (el.hasAttribute('data-xray-role')) return el;
        el = el.parentElement;
      }
      return null;
    }

    demo.addEventListener('mousemove', (e: MouseEvent) => {
      const target = findXrayTarget(e.target as Element);
      if (!target) {
        highlight.style.opacity = '0';
        hud.style.opacity = '0';
        return;
      }

      const demoRect = demo.getBoundingClientRect();
      const rect = target.getBoundingClientRect();

      const top = rect.top - demoRect.top;
      const left = rect.left - demoRect.left;
      const width = rect.width;
      const height = rect.height;

      highlight.style.top = `${top}px`;
      highlight.style.left = `${left}px`;
      highlight.style.width = `${width}px`;
      highlight.style.height = `${height}px`;
      highlight.style.opacity = '1';

      const role = target.getAttribute('data-xray-role') || 'Unknown';
      hudRole.textContent = role;
      hudSize.textContent = `${Math.round(width)} x ${Math.round(height)}`;

      let hudTop = top - 36;
      let hudLeft = left;
      if (hudTop < 4) hudTop = top + height + 8;

      hud.style.top = `${hudTop}px`;
      hud.style.left = `${hudLeft}px`;
      hud.style.opacity = '1';
    });

    demo.addEventListener('mouseleave', () => {
      highlight.style.opacity = '0';
      hud.style.opacity = '0';
    });
  </script>

  <!-- Stories-style video showcase with auto-rotation -->
  <script>
    const PLAYBACK_RATE = 1.5;

    const videos = [
      document.getElementById('video-web') as HTMLVideoElement,
      document.getElementById('video-program') as HTMLVideoElement,
    ];
    const segments = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-video-idx]'));
    const fills = segments.map((seg) => seg.querySelector('[data-progress-fill]') as HTMLElement);
    const labels = segments.map((seg) => seg.querySelector('[data-progress-label]') as HTMLElement);

    let activeIndex = 0;

    // Force playback rate (set on metadata load to survive resets)
    videos.forEach((v) => {
      v.playbackRate = PLAYBACK_RATE;
      v.addEventListener('loadedmetadata', () => {
        v.playbackRate = PLAYBACK_RATE;
      });
    });

    function setLabelStates(activeIdx: number) {
      labels.forEach((label, i) => {
        if (i === activeIdx) {
          label.classList.add('text-xray-green-light');
          label.classList.remove('text-gray-500');
        } else {
          label.classList.remove('text-xray-green-light');
          label.classList.add('text-gray-500');
        }
      });
    }

    function activate(idx: number) {
      if (idx === activeIndex) return;

      const prev = videos[activeIndex];
      const next = videos[idx];

      prev.pause();
      prev.style.opacity = '0';

      // Reset only the new active bar; leave others as-is
      fills[idx].style.width = '0%';

      setLabelStates(idx);

      next.currentTime = 0;
      next.style.opacity = '1';
      next.playbackRate = PLAYBACK_RATE;
      next.play();

      activeIndex = idx;
    }

    videos.forEach((v, i) => {
      v.addEventListener('ended', () => {
        if (i !== activeIndex) return;
        fills[i].style.width = '100%';
        activate(i === 0 ? 1 : 0);
      });
    });

    // Smooth progress fill driven by rAF (~60fps) instead of sparse timeupdate events
    function tickProgress() {
      const v = videos[activeIndex];
      if (v && v.duration > 0 && !v.ended) {
        const pct = Math.min(100, (v.currentTime / v.duration) * 100);
        fills[activeIndex].style.width = `${pct}%`;
      }
      requestAnimationFrame(tickProgress);
    }
    requestAnimationFrame(tickProgress);

    segments.forEach((seg, i) => {
      seg.addEventListener('click', () => activate(i));
    });
  </script>
